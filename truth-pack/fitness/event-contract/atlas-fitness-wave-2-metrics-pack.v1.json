  "dashboard_acceptance_checks": [
    {
      "check_id": "weekly-adherence-funnel-uses-frozen-weekly-grain",
      "description": "The dashboard computes weekly adherence using distinct member_id + week_start_date windows, not raw event counts.",
      "funnel_ids": [
        "weekly_adherence_funnel"
      ],
      "kpi_ids": [
        "weekly_goal_hit_rate"
      ],
      "criteria": [
        "The weekly adherence funnel starts from weekly_progress_state_available.",
        "The weekly goal tile shows both numerator and denominator labels.",
        "Queries exclude weekly windows where plannedWorkoutCount is 0."
      ]
    },
    {
      "check_id": "session-outcomes-use-session-grain",
      "description": "Workout completion rate stays on distinct member_id + session_id grain and never treats repeated emits as extra completions.",
      "funnel_ids": [
        "weekly_adherence_funnel"
      ],
      "kpi_ids": [
        "workout_completion_rate"
      ],
      "criteria": [
        "Only workout_completed and workout_missed participate in the completion denominator.",
        "Repeated writes for the same session_id collapse to one denominator row.",
        "Dashboard labels the window as rolling_7d by default."
      ]
    },
    {
      "check_id": "recovery-funnel-joins-warning-lineage-to-receipts",
      "description": "Recovery guardrail conversion uses outbound_id to source_outbound_id lineage instead of member-only joins.",
      "funnel_ids": [
        "recovery_guardrail_funnel"
      ],
      "kpi_ids": [
        "recovery_warning_rate",
        "recovery_guardrail_application_rate"
      ],
      "criteria": [
        "Recovery warning counts start from athlete_readiness_state_available.",
        "Receipt conversion requires receipt.sourceOutboundId to match recovery_warning outbound_id.",
        "Rejected or missing receipts do not count as applied guardrails."
      ]
    },
    {
      "check_id": "later-lane-surfaces-stay-out-of-this-pack",
      "description": "This dashboard pack does not quietly widen into later auth, shared UI, cross-sell, or ML lanes.",
