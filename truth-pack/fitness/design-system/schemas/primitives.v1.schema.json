{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fitness.design-system.primitives.schema.v1",
  "title": "Fitness Design System Primitive Contracts v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packId",
    "packVersion",
    "status",
    "ownerRepoId",
    "tokensPackRef",
    "primitiveContracts"
  ],
  "properties": {
    "packId": { "type": "string" },
    "packVersion": { "type": "string" },
    "status": { "type": "string" },
    "ownerRepoId": { "type": "string" },
    "tokensPackRef": { "type": "string" },
    "primitiveContracts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variants", "invariants", "sourceSurfaces"],
        "properties": {
          "id": { "type": "string" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "semanticRefs"],
              "properties": {
                "id": { "type": "string" },
                "semanticRefs": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "sourceSurfaces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
