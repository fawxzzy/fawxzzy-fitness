{
  "name": "fawxzzyfitness",
  "version": "0.3.88",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean:next": "node scripts/cleanup-repo.mjs --only-build-cache",
    "rebuild:clean": "npm run clean:next && npm run build",
    "start": "next start",
    "qa:screenshot": "node .codex/qa/cdp-edge.mjs",
    "qa:ui-pass": "node scripts/qa-ui-pass.mjs",
    "qa:matrix": "node scripts/qa-matrix.mjs",
    "qa:boards": "python scripts/build-mobile-regression-boards.py",
    "migration:validate": "node scripts/migration/validate-supabase-chain.mjs",
    "migration:parity": "node scripts/migration/parity-report.mjs",
    "lint": "next lint",
    "prebuild": "npm run gen:exercise-icons && node scripts/generate-icons.mjs",
    "dev:assets": "node scripts/generate-icons.mjs",
    "sync:exercise-icons": "node scripts/syncExerciseIcons.mjs",
    "sync:assets": "npm run sync:exercise-icons",
    "icons:normalize": "node scripts/normalizeExerciseIcons.mjs",
    "gen:exercise-icons": "node scripts/generate-exercise-icon-manifest.mjs",
    "validate:exercise-info-endpoint": "node scripts/validate-exercise-info-endpoint.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "audit:exercise-icons": "node scripts/audit-exercise-icons.mjs",
    "cleanup:repo": "node scripts/cleanup-repo.mjs",
    "cleanup:repo:archive": "node scripts/cleanup-repo.mjs --archive",
    "cleanup:repo:full": "node scripts/cleanup-repo.mjs --include-build-cache",
    "prepare": "node scripts/setup-githooks.mjs",
    "playbook-runtime:install-package": "node scripts/playbook-runtime.mjs --install-package",
    "playbook-runtime:install-official-fallback": "node scripts/playbook-runtime.mjs --install-official-fallback",
    "ai-context": "node scripts/playbook-runtime.mjs ai-context",
    "ai-contract": "node scripts/playbook-runtime.mjs ai-contract",
    "context": "node scripts/playbook-runtime.mjs context",
    "query:modules": "node scripts/playbook-runtime.mjs query modules",
    "explain:architecture": "node scripts/playbook-runtime.mjs explain architecture",
    "ask:repo-context": "node scripts/playbook-runtime.mjs ask --repo-context",
    "ignore:suggest": "node scripts/playbook-runtime.mjs ignore suggest",
    "ignore:apply": "node scripts/playbook-runtime.mjs ignore apply --safe-defaults",
    "index": "node scripts/playbook-runtime.mjs index",
    "plan": "node scripts/playbook-runtime.mjs plan",
    "pilot": "node scripts/playbook-runtime.mjs pilot",
    "sanity": "npm run verify:strict",
    "sanity:quick": "npm run lint",
    "typecheck:mobile-regression-harness": "tsc -p tsconfig.mobile-regression.json --pretty false",
    "verify:mobile-regression": "npm run typecheck:mobile-regression-harness && npm run test:mobile-regression-fixtures",
    "verify": "node scripts/playbook-runtime.mjs verify",
    "verify:strict": "npm run lint && npm run verify:mobile-regression && npm run build",
    "test:auth-ui-contracts": "node --import ./scripts/register-test-aliases.mjs --test src/app/login/loginScreenState.test.ts src/app/login/LoginScreen.contract.test.ts src/components/ui/app/designSystem.contract.test.ts",
    "test:playbook-runtime": "node --test scripts/playbook-runtime.test.mjs",
    "test:playbook-adoption": "node --test tests/playbook-adoption-evidence.test.mjs",
    "test:playbook-verification": "node --test tests/playbook-verification-report.test.mjs",
    "test:fitness-event-contracts": "node --test src/lib/ecosystem/fitness-integration-contract.test.ts src/lib/ecosystem/fitness-shadow-events.test.ts src/lib/ecosystem/fitness-metrics-pack.test.ts",
    "test:fitness-shadow-warehouse": "node --test src/lib/ecosystem/fitness-shadow-warehouse.test.ts src/lib/ecosystem/fitness-funnel-dashboard.test.ts",
    "test:fitness-growth-shadow": "node --test src/lib/ecosystem/fitness-growth-pack.test.ts src/lib/ecosystem/fitness-growth-shadow.test.ts",
    "test:fitness-pilot-readiness": "node --test src/lib/ecosystem/fitness-growth-pilot-readiness-pack.test.ts src/lib/ecosystem/fitness-growth-pilot-readiness.test.ts",
    "backfill:fitness-pilot-impressions": "node scripts/backfill-fitness-pilot-impressions.mjs",
    "evaluate:fitness-pilot-readiness": "node scripts/evaluate-fitness-pilot-readiness.mjs",
    "record:fitness-pilot-evidence": "node scripts/record-fitness-pilot-evidence.mjs",
    "test:session-set-count": "node --test src/components/session/setCountSync.test.ts",
    "test:mobile-regression-fixtures": "node --import ./scripts/register-test-aliases.mjs --test src/lib/exercise-disclosure.test.ts src/lib/history-preview.test.ts src/lib/history-sessions-page-loader.test.ts src/lib/workout-card-surface-policy.test.ts src/lib/workout-card-view-models.test.ts tests/mobile-regression/fixtures.test.ts tests/mobile-regression/inventory.test.ts tests/mobile-regression/build-mobile-regression-boards.test.ts tests/mobile-regression/contracts.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "motion": "^12.38.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
