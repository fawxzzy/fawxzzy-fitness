{
  "runtime": {
    "stateRoot": ".playbook"
  },
  "verify": {
    "rules": {
      "requireNotesOnChanges": [
        {
          "whenChanged": ["src/**", "app/**", "server/**", "supabase/**"],
          "mustTouch": ["docs/PLAYBOOK_NOTES.md", "docs/playbook-notes/**"]
        }
      ],
      "migrationsAppendOnly": [
        {
          "globs": ["supabase/migrations/**/*.sql"]
        }
      ]
    }
  },
  "commands": {
    "verify": "npm run verify",
    "plan": "npm run plan"
  }
}
